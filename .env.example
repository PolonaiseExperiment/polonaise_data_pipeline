# SSH Configuration - Copy this to .env and fill in your values
SSH_HOST=your.server.com
SSH_USERNAME=your_username
SSH_KEY_PATH=/path/to/your/ssh/key

# Paths
LOCAL_SOURCE_PATH=/path/to/local/data
REMOTE_DEST_PATH=/path/to/remote/data
DATABASE_PATH=/path/to/pipeline.json

# Transfer Settings
MAX_PARALLEL_TRANSFERS=3
SKIP_RECENT_MINUTES=15

# Slack Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx

# Verification
FULL_VERIFY_HOUR=3
