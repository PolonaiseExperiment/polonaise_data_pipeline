# SSH Configuration - Copy this to .env and fill in your values
SSH_HOST=your.server.com
SSH_USERNAME=your_username
SSH_KEY_PATH=/path/to/your/ssh/key

# Paths
LOCAL_SOURCE_PATH=/path/to/local/data
REMOTE_DEST_PATH=/path/to/remote/data
DATABASE_PATH=/path/to/pipeline.json

# Transfer Settings
MAX_PARALLEL_TRANSFERS=3
SKIP_RECENT_MINUTES=15

# Folders to skip / sync first (top-level names under LOCAL_SOURCE_PATH)
# IGNORE_LIST_FILE=archive_ignore.txt
# PRIORITY_DIRS=Run48_2026_May

# --- Compressed transfers (optional) ---
# Large single-channel .tdms files are encoded to FLAC+JSON locally
# (bit-exact, self-verified), shipped compressed, then rebuilt to .tdms on
# the remote by scripts/remote_decode.py running in a venv there. The remote
# needs a git clone of this repo and a venv with:
#   numpy soundfile nptdms xxhash
# COMPRESSION_ENABLED=false
# REMOTE_COMPRESSED_PATH=/path/to/remote/compressed
# REMOTE_PYTHON=/path/to/venv/bin/python3
# REMOTE_REPO_PATH=/path/to/clone/of/this/repo
# COMPRESSION_MIN_BYTES=10485760
# REMOTE_DB_PATH=/path/to/remote/pipeline.json

# Slack Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx

# Verification
FULL_VERIFY_HOUR=3

# --- Optional Tuning (defaults shown) ---

# SSH tuning
# SSH_TIMEOUT=30
# SSH_KEEPALIVE=30

# Transfer tuning
# TRANSFER_BUFFER_SIZE=1048576

# Checksum tuning
# CHECKSUM_CHUNK_SIZE=8388608
# REMOTE_COMMAND_TIMEOUT=300

# Slack tuning
# SLACK_TIMEOUT=30

# Logging
# LOG_FILE_PATH=transfer.log
