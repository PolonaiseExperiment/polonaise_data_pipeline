# Archive Configuration Template
#
# The pipeline uses ONE config pointing at the archive ROOT. Copy this to the
# project root as .env and fill in your values:
#
#   cp runs/template.env .env
#
# Then just run:
#   python scripts/sync.py --daemon
#   python scripts/sync.py
#
# Which folders sync is controlled by archive_ignore.txt, not by this file, so
# new run folders are picked up automatically with no config edit.
#
# For a one-off job against a different source or database, copy this file
# somewhere else and point at it:
#   python scripts/sync.py --config /path/to/other.env
#
# Files matching runs/*.env are gitignored. Only this template is tracked.

# SSH Configuration
SSH_HOST=your.server.com
SSH_USERNAME=your_username
SSH_KEY_PATH=/path/to/your/ssh/key

# Paths - the ARCHIVE ROOT, not a single run folder
LOCAL_SOURCE_PATH=/path/to/archive/root
REMOTE_DEST_PATH=/path/to/remote/root
DATABASE_PATH=/path/to/pipeline_archive.json

# Which folders to skip
# IGNORE_LIST_FILE: one top-level folder name per line, # for comments.
#                   Relative paths resolve against the project root.
# IGNORE_DIRS:      comma-separated alternative to the file.
#                   If both are set, the file wins.
# SKIP_ROOT_FILES:  ignore loose files sitting directly in the archive root
#                   (Excel ~$ lock files, Thumbs.db, desktop.ini and similar).
IGNORE_LIST_FILE=archive_ignore.txt
# IGNORE_DIRS=Run12_2020_August,Run13_2020_Oktober
SKIP_ROOT_FILES=true

# Transfer Settings
MAX_PARALLEL_TRANSFERS=3
SKIP_RECENT_MINUTES=15

# Slack Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx

# Verification
FULL_VERIFY_HOUR=3

# --- Optional Tuning (defaults shown) ---

# SSH tuning
# SSH_TIMEOUT=30
# SSH_KEEPALIVE=30
# SSH_WINDOW_SIZE=2147483647
# SSH_MAX_PACKET_SIZE=131072

# Transfer tuning
# TRANSFER_BUFFER_SIZE=1048576

# Checksum tuning
# CHECKSUM_CHUNK_SIZE=8388608
# REMOTE_COMMAND_TIMEOUT=300

# Slack tuning
# SLACK_TIMEOUT=30

# Logging
# LOG_FILE_PATH=transfer.log
