# Run Configuration Template
#
# To create a new run config:
#   cp runs/template.env runs/run46.env
#   Edit runs/run46.env with your run-specific paths
#
# Then use:
#   python scripts/sync.py --run run46
#   python scripts/sync.py --run run46 --daemon
#
# Run configs are gitignored. Only this template is tracked.

# SSH Configuration
SSH_HOST=your.server.com
SSH_USERNAME=your_username
SSH_KEY_PATH=/path/to/your/ssh/key

# Paths - CHANGE THESE FOR EACH RUN
LOCAL_SOURCE_PATH=/path/to/local/data
REMOTE_DEST_PATH=/path/to/remote/data
DATABASE_PATH=/path/to/pipeline.json

# Transfer Settings
MAX_PARALLEL_TRANSFERS=3
SKIP_RECENT_MINUTES=15

# Slack Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/xxx/xxx

# Verification
FULL_VERIFY_HOUR=3

# --- Optional Tuning (defaults shown) ---

# SSH tuning
# SSH_TIMEOUT=30
# SSH_KEEPALIVE=30
# SSH_WINDOW_SIZE=2147483647
# SSH_MAX_PACKET_SIZE=131072

# Transfer tuning
# TRANSFER_BUFFER_SIZE=1048576

# Checksum tuning
# CHECKSUM_CHUNK_SIZE=8388608
# REMOTE_COMMAND_TIMEOUT=300

# Slack tuning
# SLACK_TIMEOUT=30

# Logging
# LOG_FILE_PATH=transfer.log
